{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cxxprobe project.yaml version 1",
  "description": "Structural contract only; see schemas/project.md for semantic and filesystem requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "parts"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "\\S" },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "$ref": "#/$defs/path", "default": "shared" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dir", "label"],
        "properties": {
          "dir": { "$ref": "#/$defs/path" },
          "label": { "$ref": "#/$defs/label" }
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "$ref": "#/$defs/path", "default": "integration" },
        "entry": { "$ref": "#/$defs/path", "default": "integration_gtest.cpp" },
        "fallback_dir": { "$ref": "#/$defs/path" }
      }
    }
  },
  "$defs": {
    "label": {
      "description": "Case-sensitive worker submission key; matches worker PR #17 PART_LABEL.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "not": { "pattern": "[^A-Za-z0-9_-]" }
    },
    "path": {
      "description": "Normalized nonempty relative POSIX path; no empty, dot, parent, drive, control or backslash components.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+(/[^/]+)*$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)|[\\\\:\\u0000-\\u001f\\u007f]|/$" }
    }
  }
}
